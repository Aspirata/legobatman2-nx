+static uint32_t
+nouveau_horizon_channel_completion_reservation_entries(
+   const struct nouveau_horizon_channel *channel)
+{
+   /* submit_locked keeps FINAL_SKID after its completion tail, and may first
+    * prepend a total-order wait. Every public producer must preserve this
+    * headroom while accepting entries, not discover its absence at submit.
+    */
+   return (channel->mapped_completion_enabled ? 2u : 1u) +
+          (channel->device->total_order_channels ? 1u : 0u);
+}
